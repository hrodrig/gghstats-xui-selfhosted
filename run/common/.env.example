# gghstats-xui-selfhosted — template for Docker Compose variable substitution. Do not commit real secrets.
#
# This repository's own semver is in VERSION at the repository root — bump for infra/doc/layout releases.
#
# Recommended: keep SQLite and this file under one host directory (outside the git clone).
#   1. export GGHSTATS_HOST_DATA=/home/gghstats/gghstats-data   # example
#   2. mkdir -p "$GGHSTATS_HOST_DATA"
#   3. Copy this file to "${GGHSTATS_HOST_DATA}/.env" and edit secrets.
#   4. Set GGHSTATS_HOST_DATA in that .env to the same absolute path (required for volume mounts).
#   5. From the clone root:
#        docker compose --env-file "${GGHSTATS_HOST_DATA}/.env" -f run/docker-compose/minimal/docker-compose.yml up -d

# --- gghstats (upstream, API-only mode) ---
# Required for real GitHub sync (unless demo mode below).
GGHSTATS_GITHUB_TOKEN=

# Demo UI with sample data (gghstats >= 0.9.0). No token, sync, or update check.
# Unset for production. When true, leave GGHSTATS_GITHUB_TOKEN empty.
# GGHSTATS_DEMO=true

# Run gghstats in API-only mode (no dashboard HTML) — required by gghstats-xui, which
# renders its own UI in front of this backend. gghstats >= 0.11.0.
GGHSTATS_API_ONLY=true

# Shared API token. The xui BFF presents this token to gghstats on every proxied request.
# Must be the SAME value in both containers. Generate with: openssl rand -hex 32
GGHSTATS_API_TOKEN=

# Full repo filter for sync, e.g. "your-github-user/*". Default * = everything the token can see.
GGHSTATS_FILTER=*
GGHSTATS_SYNC_INTERVAL=1h
GGHSTATS_INCLUDE_PRIVATE=false
# Report visibility of *private* repos (gghstats >= 1.5.0). Separate from INCLUDE_PRIVATE.
GGHSTATS_REPORT_PRIVATE=false

# Container image tag for the upstream gghstats backend — must match a published
# ghcr.io/hrodrig/gghstats release. Unrelated to this repo's VERSION file.
GGHSTATS_VERSION=v1.6.6

# --- gghstats-xui (BFF / dashboard) ---
# Container image tag for gghstats-xui — must match a published ghcr.io/hrodrig/gghstats-xui release.
GGHSTATS_XUI_VERSION=v0.1.3

# Public port the xui dashboard listens on (host). BFF listens on 3000 inside the container.
XUI_PORT=3000

# --- Compose layout ---
# Host directory bind-mounted to /data in the gghstats container (SQLite).
# Uncomment and set when using "${GGHSTATS_HOST_DATA}/.env" (recommended on servers):
# GGHSTATS_HOST_DATA=/home/gghstats/gghstats-data
