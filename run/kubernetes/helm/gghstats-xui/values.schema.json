                "memory": {
                  "oneOf": [
                    { "type": "string", "minLength": 1 },
                    { "type": "number" }
                  ]
                }
              },
              "additionalProperties": true
            },
            "limits": {
              "type": "object",
              "required": ["cpu", "memory"],
              "properties": {
                "cpu": {
                  "oneOf": [
                    { "type": "string", "minLength": 1 },
                    { "type": "number" }
                  ]
                },
                "memory": {
                  "oneOf": [
                    { "type": "string", "minLength": 1 },
                    { "type": "number" }
                  ]
                }
              },
              "additionalProperties": true
            }
